//@version=6
strategy("NYC Opening Box ORB — FTMO Step 1", overlay=true, initial_capital=200000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=4.60, slippage=2, process_orders_on_close=true, max_lines_count=200, max_labels_count=500, max_boxes_count=200)

// ═══════════════════════════════════════════════════════════════════
// NYC OPENING BOX ORB — FTMO STEP 1 COMPLIANT (200K ACCOUNT)
// ═══════════════════════════════════════════════════════════════════
// FTMO Rules:
//  • Daily Loss Limit: $20,000 (10% of $200K)
//  • Overall Drawdown Limit: $20,000 (10% of $200K)  
//  • No Overnight Holds: Mandatory close at session end
//  • Max Risk Per Trade: $1,000 (0.5% account)
// ═══════════════════════════════════════════════════════════════════

// ───────────────────────── INPUTS ─────────────────────────
openingSession   = input.session("0930-1010", "Opening Box Window (NY)", tooltip="09:30–10:10 ET")
tradingSession   = input.session("0930-1600", "NY Trading Session")
sessTimezone     = input.string("America/New_York", "Timezone")
rrMultiple       = input.float(1.5, "Risk:Reward Ratio", minval=0.5, maxval=3.0, step=0.1)
oneSignalPerDay  = input.bool(true, "Only one trade total per day")
dollarPerPoint   = input.float(20.0, "$ per point (NQ=$20, MNQ=$2, ES=$50, MES=$5)", minval=0.01)
maxDailyLoss     = input.float(20000.0, "Daily Loss Limit ($)", minval=1000.0)
maxAccountDD     = input.float(20000.0, "Account Drawdown Limit ($)", minval=1000.0)
maxRiskPerTrade  = input.float(1000.0, "Max Risk Per Trade ($)", minval=100.0, maxval=5000.0, step=100.0)
extendBoxBars    = input.int(60, "Extend box forward (bars)", minval=5)
extendTradeBars  = input.int(40, "Extend lines forward (bars)", minval=5)

// Colors
boxBorderColor = color.new(color.orange, 40)
boxBgColor     = color.new(color.orange, 92)
midLineColor   = color.new(color.yellow, 40)
slLineColor    = color.new(color.red, 35)
tpLineColor    = color.new(#26a69a, 35)
slTagColor     = color.new(color.red, 15)
tpTagColor     = color.new(#26a69a, 15)
flatColor      = color.new(color.gray, 15)
warningColor   = color.new(color.maroon, 20)

// ───────────────────────── SESSION ─────────────────────────
inOpeningWindow = not na(time(timeframe.period, openingSession, sessTimezone))
inTradingWindow = not na(time(timeframe.period, tradingSession, sessTimezone))
barClosed = barstate.isconfirmed
newDay = ta.change(dayofmonth(time, sessTimezone)) != 0

// ───────────────────────── BOX STATE ─────────────────────────
var float boxHigh = na
var float boxLow = na
var float boxMid = na
var bool boxLocked = false
var bool tradeTakenToday = false

var bool shortBreakoutSeen = false
var bool shortReenteredBox = false
var bool longBreakoutSeen = false
var bool longReenteredBox = false

var float dailyPnL = 0.0
var float peakAccountValue = 200000.0

if newDay
    boxHigh := na
    boxLow := na
    boxMid := na
    boxLocked := false
    tradeTakenToday := false
    shortBreakoutSeen := false
    shortReenteredBox := false
    longBreakoutSeen := false
    longReenteredBox := false
    dailyPnL := 0.0
    peakAccountValue := strategy.equity

if inOpeningWindow and not boxLocked
    boxHigh := na(boxHigh) ? high : math.max(boxHigh, high)
    boxLow := na(boxLow) ? low : math.min(boxLow, low)

justFinishedBox = inOpeningWindow[1] and not inOpeningWindow and not boxLocked
if justFinishedBox
    boxLocked := true
    boxMid := (boxHigh + boxLow) / 2
    box.new(bar_index, boxHigh, bar_index + extendBoxBars, boxLow, border_color=boxBorderColor, bgcolor=boxBgColor, border_width=2)
    line.new(bar_index, boxMid, bar_index + extendBoxBars, boxMid, color=midLineColor, width=1, style=line.style_dashed)

haveBox = boxLocked and not na(boxHigh) and not na(boxLow)

// ───────────────────────── TRADE STATE ─────────────────────────
var bool inTrade = false
var string activeSide = na
var float activeEntry = na
var float activeSL = na
var float activeTP = na
var int entryBarIndex = na
var float activeQty = 0.0

canSignal = haveBox and inTradingWindow and not inTrade and (not oneSignalPerDay or not tradeTakenToday)

longSetup = false
shortSetup = false

// ───────────────────────── RETEST ENTRY LOGIC ─────────────────────────
if canSignal and barClosed
    if not shortBreakoutSeen and not longBreakoutSeen
        if close < boxLow
            shortBreakoutSeen := true
        else if close > boxHigh
            longBreakoutSeen := true

    else if shortBreakoutSeen
        if close > boxLow
            shortReenteredBox := true

        retestTouch = high >= boxLow
        rejectionCandle = retestTouch and (close < open) and (close <= boxLow)
        shakeoutContinuation = shortReenteredBox and (close < boxLow)

        if rejectionCandle or shakeoutContinuation
            shortSetup := true
            shortBreakoutSeen := false
            shortReenteredBox := false

    else if longBreakoutSeen
        if close < boxHigh
            longReenteredBox := true

        retestTouch = low <= boxHigh
        rejectionCandle = retestTouch and (close > open) and (close >= boxHigh)
        shakeoutContinuation = longReenteredBox and (close > boxHigh)

        if rejectionCandle or shakeoutContinuation
            longSetup := true
            longBreakoutSeen := false
            longReenteredBox := false

bool longFire = false
bool shortFire = false
bool slFire = false
bool tpFire = false
bool flatFire = false

// ───────────────────────── LONG ENTRY ─────────────────────────
if longSetup
    riskPts = close - boxMid
    if riskPts > 0
        riskDollars = riskPts * dollarPerPoint
        
        // Calculate quantity respecting FTMO max risk per trade
        entryQty = riskDollars <= maxRiskPerTrade ? 1 : math.floor(maxRiskPerTrade / riskDollars)
        
        // Don't exceed daily loss limit
        if dailyPnL + (riskDollars * entryQty) <= maxDailyLoss
            inTrade := true
            activeSide := "long"
            activeEntry := close
            activeSL := boxMid
            activeTP := close + riskPts * rrMultiple
            entryBarIndex := bar_index
            activeQty := entryQty
            tradeTakenToday := true
            longFire := true

            strategy.entry("Long", strategy.long, qty=entryQty)

            line.new(bar_index, activeEntry, bar_index + extendTradeBars, activeEntry, color=color.new(color.lime, 20), width=2, style=line.style_solid)
            line.new(bar_index, activeSL, bar_index + extendTradeBars, activeSL, color=slLineColor, width=1, style=line.style_dotted)
            line.new(bar_index, activeTP, bar_index + extendTradeBars, activeTP, color=tpLineColor, width=1, style=line.style_dotted)

            label.new(bar_index + extendTradeBars, activeEntry, "E " + str.tostring(activeEntry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.black, size=size.tiny)
            label.new(bar_index + extendTradeBars, activeSL, "SL " + str.tostring(activeSL, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=slTagColor, textcolor=color.white, size=size.tiny)
            label.new(bar_index + extendTradeBars, activeTP, "TP " + str.tostring(activeTP, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=tpTagColor, textcolor=color.white, size=size.tiny)

// ───────────────────────── SHORT ENTRY ─────────────────────────
if shortSetup
    riskPts = boxMid - close
    if riskPts > 0
        riskDollars = riskPts * dollarPerPoint
        
        // Calculate quantity respecting FTMO max risk per trade
        entryQty = riskDollars <= maxRiskPerTrade ? 1 : math.floor(maxRiskPerTrade / riskDollars)
        
        // Don't exceed daily loss limit
        if dailyPnL + (riskDollars * entryQty) <= maxDailyLoss
            inTrade := true
            activeSide := "short"
            activeEntry := close
            activeSL := boxMid
            activeTP := close - riskPts * rrMultiple
            entryBarIndex := bar_index
            activeQty := entryQty
            tradeTakenToday := true
            shortFire := true

            strategy.entry("Short", strategy.short, qty=entryQty)

            line.new(bar_index, activeEntry, bar_index + extendTradeBars, activeEntry, color=color.new(color.red, 20), width=2, style=line.style_solid)
            line.new(bar_index, activeSL, bar_index + extendTradeBars, activeSL, color=slLineColor, width=1, style=line.style_dotted)
            line.new(bar_index, activeTP, bar_index + extendTradeBars, activeTP, color=tpLineColor, width=1, style=line.style_dotted)

            label.new(bar_index + extendTradeBars, activeEntry, "E " + str.tostring(activeEntry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
            label.new(bar_index + extendTradeBars, activeSL, "SL " + str.tostring(activeSL, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=slTagColor, textcolor=color.white, size=size.tiny)
            label.new(bar_index + extendTradeBars, activeTP, "TP " + str.tostring(activeTP, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=tpTagColor, textcolor=color.white, size=size.tiny)

// ───────────────────────── LONG EXIT ─────────────────────────
if inTrade and activeSide == "long" and bar_index >= entryBarIndex + 1
    strategy.exit("Long Exit", from_entry="Long", stop=activeSL, limit=activeTP)
    
    if low <= activeSL
        label.new(bar_index, activeSL, "SL", style=label.style_label_down, color=slTagColor, textcolor=color.white, size=size.tiny)
        slFire := true
        pnl = (activeSL - activeEntry) * activeQty * dollarPerPoint
        dailyPnL += pnl
        inTrade := false
        activeSide := na

    else if high >= activeTP
        label.new(bar_index, activeTP, "TP", style=label.style_label_down, color=tpTagColor, textcolor=color.white, size=size.tiny)
        tpFire := true
        pnl = (activeTP - activeEntry) * activeQty * dollarPerPoint
        dailyPnL += pnl
        inTrade := false
        activeSide := na

// ───────────────────────── SHORT EXIT ─────────────────────────
if inTrade and activeSide == "short" and bar_index >= entryBarIndex + 1
    strategy.exit("Short Exit", from_entry="Short", stop=activeSL, limit=activeTP)
    
    if high >= activeSL
        label.new(bar_index, activeSL, "SL", style=label.style_label_up, color=slTagColor, textcolor=color.white, size=size.tiny)
        slFire := true
        pnl = (activeEntry - activeSL) * activeQty * dollarPerPoint
        dailyPnL += pnl
        inTrade := false
        activeSide := na

    else if low <= activeTP
        label.new(bar_index, activeTP, "TP", style=label.style_label_up, color=tpTagColor, textcolor=color.white, size=size.tiny)
        tpFire := true
        pnl = (activeEntry - activeTP) * activeQty * dollarPerPoint
        dailyPnL += pnl
        inTrade := false
        activeSide := na

// ───────────────────────── FTMO: DAILY LOSS LIMIT ─────────────────────────
if dailyPnL <= -maxDailyLoss and inTrade
    strategy.close_all(comment="Daily Loss Limit")
    label.new(bar_index, high, "DLL", style=label.style_label_down, color=warningColor, textcolor=color.white, size=size.small)
    flatFire := true
    inTrade := false
    activeSide := na

// ───────────────────────── FTMO: DRAWDOWN LIMIT ─────────────────────────
currentDD = peakAccountValue - strategy.equity
if currentDD >= maxAccountDD and inTrade
    strategy.close_all(comment="Drawdown Limit")
    label.new(bar_index, high, "DD", style=label.style_label_down, color=warningColor, textcolor=color.white, size=size.small)
    flatFire := true
    inTrade := false
    activeSide := na

// ───────────────────────── NO OVERNIGHT HOLD ─────────────────────────
isSessionEnd = inTradingWindow[1] and not inTradingWindow

if isSessionEnd and inTrade
    strategy.close_all(comment="Session Close")
    flatLabelY = (activeSide == "long" ? high : low)
    flatLabelStyle = (activeSide == "long" ? label.style_label_down : label.style_label_up)
    label.new(bar_index, flatLabelY, "CLOSE", style=flatLabelStyle, color=flatColor, textcolor=color.white, size=size.tiny)
    flatFire := true
    inTrade := false
    activeSide := na

// ───────────────────────── PLOTS ─────────────────────────
plotshape(longFire,  title="Long Entry",      style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0),   size=size.small)
plotshape(shortFire, title="Short Entry",     style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small)
plotshape(slFire,    title="SL Exit",         style=shape.xcross,       location=location.abovebar, color=color.new(color.maroon, 0), size=size.small)
plotshape(tpFire,    title="TP Exit",         style=shape.xcross,       location=location.belowbar, color=color.new(color.teal, 0),   size=size.small)
plotshape(flatFire,  title="Session Flatten", style=shape.diamond,      location=location.abovebar, color=color.new(color.gray, 0),   size=size.small)

alertcondition(longSetup,  title="Long Entry",  message="Box retest long entry triggered.")
alertcondition(shortSetup, title="Short Entry", message="Box retest short entry triggered.")
alertcondition(slFire,     title="SL Hit",      message="Stop loss triggered.")
alertcondition(tpFire,     title="TP Hit",      message="Take profit triggered.")
alertcondition(dailyPnL <= -maxDailyLoss, title="Daily Loss Limit", message="Daily loss limit reached.")
alertcondition(currentDD >= maxAccountDD, title="Drawdown Limit", message="Drawdown limit reached.")
